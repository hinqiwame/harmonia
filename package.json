{
  "name": "harmonia-guitar-tuner",
  "version": "1.0.0",
  "description": "Professional Guitar Tuner with multiple tuning support - by hinqiwame",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder -wml",
    "build:win": "electron-builder --win portable -p never",
    "build:mac": "electron-builder --mac -p never",
    "build:linux": "electron-builder --linux AppImage -p never",
    "build:installer": "electron-builder --win nsis -p never"
  },
  "author": "hinqiwame (Vadim)",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.hinqiwame.harmonia",
    "productName": "Harmonia Guitar Tuner",
    "directories": {
      "output": "build_dist"
    },
    "files": [
      "main.js",
      "index.html",
      "index.css",
      "app.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Harmonia-v${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "artifactName": "Harmonia-v${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "artifactName": "Harmonia-v${version}.${ext}"
    },
    "portable": {
      "artifactName": "Harmonia-v${version}.exe"
    }
  }
}